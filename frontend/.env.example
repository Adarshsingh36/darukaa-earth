# Base URL of the Darukaa.Earth FastAPI backend (no trailing slash).
# Local dev: http://localhost:8000
# Production: https://your-backend.onrender.com
VITE_API_URL=

# Mapbox access token, used by Mapbox GL JS and Mapbox GL Draw.
# Get one free at https://account.mapbox.com/access-tokens/
# Without this set, the app will run but show a "Mapbox token not configured"
# message wherever the map would appear.
VITE_MAPBOX_TOKEN=
