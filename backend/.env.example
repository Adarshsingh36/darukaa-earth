# PostgreSQL connection string. Must point at a database with PostGIS enabled
# (CREATE EXTENSION postgis;). Locally: postgresql://postgres:postgres@localhost:5432/darukaa
DATABASE_URL=

# Secret used to sign JWTs. Generate a strong random value for anything beyond local dev,
# e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Comma-separated list of origins allowed to call the API (no trailing slashes).
# Local dev: http://localhost:5173
# Production: https://your-frontend.vercel.app
CORS_ORIGINS=

ENVIRONMENT=development
